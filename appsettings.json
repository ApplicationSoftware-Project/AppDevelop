{
	"ConnectionStrings": {
		"DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ReceiptManager;Trusted_Connection=True;MultipleActiveResultSets=true"
	},
	"AI": {
		"OpenAIKey": ""
	},
	"ReverseProxy": {
		"Routes": {
			"analysis-proxy": {
				"ClusterId": "self-host",
				"Match": {
					"Path": "/api/proxy/analysis/{**catchall}"
				},
				"Transforms": [
					{
						"PathPattern": "/api/analysis/{**catchall}"
					}
				]
			}
		},
		"Clusters": {
			"self-host": {
				"Destinations": {
					"self": {
						"Address": "https://localhost:65289/"
					}
				},
				"HttpClient": {
					"DangerousAcceptAnyServerCertificate": true
				}
			}
		}
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*"
}
