{
	"ConnectionStrings": {
		"DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ReceiptManager;Trusted_Connection=True;MultipleActiveResultSets=true"
	},
	"AI": {
		"GeminiModel": "gemini-2.5-flash-lite",
		"GeminiKey": ""
	},
	"Jwt": {
		"Secret": "NoMoreReceiptsDevSecretKey-MinLength32Chars!!",
		"Issuer": "NoMoreReceipts",
		"Audience": "NoMoreReceiptsUsers",
		"ExpiresInSeconds": 3600,
		"RefreshTokenExpiryDays": 7
	},
	"ReverseProxy": {
		"Routes": {
			"analysis-proxy": {
				"ClusterId": "self-host",
				"Match": { "Path": "/api/proxy/analysis/{**catchall}" },
				"Transforms": [{ "PathPattern": "/api/analysis/{**catchall}" }]
			},
			"receipt-proxy": {
				"ClusterId": "self-host",
				"Match": { "Path": "/api/proxy/receipts/{**catchall}" },
				"Transforms": [{ "PathPattern": "/api/receipts/{**catchall}" }]
			},
			"ai-proxy": {
				"ClusterId": "self-host",
				"Match": { "Path": "/api/proxy/ai/{**catchall}" },
				"Transforms": [{ "PathPattern": "/api/ai/{**catchall}" }]
			},
			"auth-proxy": {
				"ClusterId": "self-host",
				"Match": { "Path": "/api/proxy/auth/{**catchall}" },
				"Transforms": [{ "PathPattern": "/api/auth/{**catchall}" }]
			}
		},
		"Clusters": {
			"self-host": {
				"Destinations": {
					"self": {
						"Address": "https://localhost:65289/"
					}
				},
				"HttpClient": {
					"DangerousAcceptAnyServerCertificate": true
				}
			}
		}
	},
	"Grpc": {
		"AuthServiceUrl": "https://localhost:65289"
	},
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*"
}